# ==============================================================================
# Variables de Entorno para Producción - DocuMind & PQRS B2B (Tercer Corte)
# ==============================================================================

# Configuración del Servidor
NODE_ENV=production
PORT=5000
TRUST_PROXY=true

# Base de Datos PostgreSQL (Supabase, Neon, Render o VPS)
DB_HOST=tu-host-postgres.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_seguro
DB_NAME=postgres
DB_SSL=true

# Seguridad y Autenticación JWT
JWT_SECRET=clave_secreta_criptografica_256_bits_produccion

# Inteligencia Artificial Multimodal (Nivel Gratuito de Google AI Studio)
GEMINI_API_KEY=AIzaSy...tu_clave_de_gemini_gratuita

# Servicio de Correo Saliente SMTP (Notificaciones de Radicación y Alertas Urgentes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones.empresa@gmail.com
SMTP_PASS=tu_app_password_gmail

# Base de Conocimiento Vectorial (Opcional si usa fallback en memoria)
PINECONE_API_KEY=tu_clave_pinecone
PINECONE_INDEX=documind
